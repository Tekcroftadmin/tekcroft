# Copy to .env.local and fill in real values.
# Restart `npm run dev` after creating/changing .env.local.

# Required — Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Optional — From address used by /api/contact
# Default if unset: Tekcroft Website <onboarding@resend.dev>  (Resend test sender)
# For production, verify your domain in Resend and set e.g.:
# CONTACT_FROM=Tekcroft <forms@tekcroft.com>
CONTACT_FROM=Tekcroft Website <onboarding@resend.dev>
