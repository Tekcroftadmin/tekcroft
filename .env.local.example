# Copy to .env.local and fill in real values.
# Restart `npm run dev` after creating/changing .env.local.

SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=forms@example.com
SMTP_PASS=your-smtp-password
MAIL_TO=admin@tekcroft.com
ALLOWED_ORIGINS=https://www.tekcroft.com,https://tekcroft.com,http://localhost:3000

# Headless WordPress (Hostinger staging CMS only — not the public site)
WORDPRESS_API_URL=https://comic-peachpuff-ibis-64.hostingersite.com/wp-json/wp/v2
WORDPRESS_SITE_URL=https://comic-peachpuff-ibis-64.hostingersite.com
NEXT_PUBLIC_SITE_URL=https://www.tekcroft.com
# REQUIRED on the live Next.js host or publish/trash will stay cached on tekcroft.com.
# Use the SAME value in WordPress wp-config.php as TEKCROFT_REVALIDATE_SECRET.
REVALIDATION_SECRET=your-secure-secret
